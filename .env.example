# mac-remote-terminal — example bridge env file.
# Copy to `.env` and edit. The bridge auto-loads `.env` from the working
# directory at boot. Existing shell exports always WIN over .env values
# (so you can override any key on the command line).
#
# Override the .env path with `BRIDGE_ENV_FILE=/abs/path/to/some.env`.

# === Phase 1 — auth + bind ===

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=

# WebSocket / HTTP port. Default 8765.
# BRIDGE_PORT=8765

# Optional explicit bind host. Default = first non-loopback Tailscale IPv4.
# BRIDGE_BIND_HOST=100.x.x.x

# === Phase 3 — filesystem allowlist ===

# Comma-separated list of dirs the bridge will spawn inside / read from.
# Falls back to $HOME if unset.
BRIDGE_ALLOWED_DIRS=/Volumes/WDSSD/Code

# === File drawer size caps ===

# Largest file the file drawer will open in the editor. Default 5 MB.
# BRIDGE_FS_READ_MAX_BYTES=5242880

# Largest body the editor's save is allowed to write. Default 5 MB.
# Separate from the read cap on purpose: reading is cheap and reversible,
# writing is neither. Lower this if you want the drawer to stay near
# read-only without turning saving off entirely.
# BRIDGE_FS_WRITE_MAX_BYTES=5242880

# === Phase 2 — transcript retention ===

# Days to keep the app's own JSONL transcripts. Default 0 = keep forever.
# These are the only copy that outlives the agent CLI's rotating history —
# set a positive number only if disk pressure demands it.
# BRIDGE_TRANSCRIPT_RETENTION_DAYS=0

# === Phase 5 — session registry ===

# Defaults to .bridge/sessions.json. Override to share registry across instances.
# BRIDGE_SESSIONS_FILE=.bridge/sessions.json

# === Phase 8 — Claude config dir + headroom ===

# Absolute CLAUDE_CONFIG_DIR handed to every Claude session. Swaps the whole
# profile: settings, hooks, enabled plugins, slash commands, native history.
# Leave unset to use the CLI's own default (~/.claude).
# `~` is expanded; relative paths are rejected.
# BRIDGE_CLAUDE_CONFIG_DIR=~/.claude1

# Route Claude's API traffic through a local Headroom optimization proxy.
# The bridge owns exactly one proxy and each session launches with
# `headroom wrap claude --no-proxy`, so concurrent sessions never race to
# bind the port. If the proxy can't start, sessions spawn unwrapped.
# BRIDGE_HEADROOM_ENABLED=true
# BRIDGE_HEADROOM_BIN=headroom
# BRIDGE_HEADROOM_PORT=8787

# Additional named profiles live in <BRIDGE_DATA_DIR>/accounts.json:
#   { "claude_config_dirs": [{ "name": "work", "configDir": "/Users/me/.claude-work" }] }

# Name sessions by asking an agent to title them, once the first turn ends.
# A separate one-shot call, so it never touches the session's conversation.
# Roughly 500 input / 15 output tokens per session. Renaming a session by hand
# pins the name and turns this off for that session.
# BRIDGE_TITLER_ENABLED=true
# BRIDGE_TITLER_MODEL=claude-haiku-4-5

# === Workflows and ultracode (Claude only) ===

# Ultracode is picked per session, at the end of the effort list. It runs the
# session at xHigh and leaves multi-agent orchestration standing, so the agent
# authors and runs workflows by default instead of waiting to be asked. It
# needs a model that can reach xHigh — Opus, Sonnet or Fable, never Haiku.
#
# These two are the bridge-wide defaults for such a session; either can be
# overridden per session in the picker. Both are written into a per-session
# --settings file, and both are left unset by default: writing either one is
# what turns the CLI's workflow feature on for that session.
#
# Advisory ceiling on the agent fleet a workflow may write. It shapes what the
# agent writes; it does not cap what it spends.
#   small (<5 agents) | medium (<15) | large (<50) | unrestricted
# BRIDGE_WORKFLOW_SIZE=medium

# Whether the word "ultracode" in a prompt opts that one turn into
# orchestration, independent of the mode. Unset leaves the CLI's default (on).
# BRIDGE_WORKFLOW_KEYWORD_TRIGGER=true

# === Phase 6 — profiles ===

# Defaults to .bridge/profiles.json.
# BRIDGE_PROFILES_FILE=.bridge/profiles.json

# === Phase 6 — file search cap (@-tag picker) ===

# Max files walked per session. Default 5000.
# BRIDGE_FILE_SEARCH_CAP=5000

# === Phase 6 — Telegram notifications (all optional; absent disables feature) ===

# See docs/setup/telegram-bot.md
# BRIDGE_TELEGRAM_BOT_TOKEN=
# BRIDGE_TELEGRAM_CHAT_ID=

# Threshold for notification (ms). Default 180000 (3 min). Set 0 to notify on every turn.
# BRIDGE_NOTIFY_MIN_DURATION_MS=180000

# Public URL included in Telegram messages. Useful when accessing via Tailscale on phone.
# BRIDGE_PUBLIC_URL=http://100.x.x.x:8765
